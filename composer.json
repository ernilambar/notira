{
    "name": "nilambar/wordish",
    "description": "WordPress plugin to improve draft notes into professional email-ready HTML.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "wordpress/wp-ai-client": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Nilambar\\Wordish\\": "app/"
        },
        "classmap": [
            "app/"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        }
    }
}
