{
	"name": "ernilambar/notira",
	"description": "WordPress plugin to improve draft notes into professional email-ready HTML.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.0",
		"ernilambar/optiz": "^1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1",
		"ernilambar/coding-standard": "^1",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpcompatibility/php-compatibility": "^10@alpha",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8",
		"wp-cli/i18n-command": "^2.7",
		"wp-cli/wp-cli": "^2.12@dev",
		"wp-coding-standards/wpcs": "^3.3",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Nilambar\\Notira\\": "app/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"php-http/discovery": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
		"lint": [
			"@lint-php",
			"@phpcs"
		],
		"lint-php": "@php ./vendor/bin/parallel-lint -p php --colors --exclude .git --exclude vendor .",
		"make-mo": "./vendor/bin/wp i18n make-mo languages/",
		"phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary",
		"pot": "./vendor/bin/wp i18n make-pot . --exclude=build,deploy,node_modules,vendor --headers='{\"POT-Creation-Date\":\"\"}'",
		"test": "@php ./vendor/bin/phpunit",
		"update-po": "./vendor/bin/wp i18n update-po languages/notira.pot languages/"
	}
}
