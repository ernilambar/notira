{
	"name": "ernilambar/notira",
	"description": "WordPress plugin to improve draft notes into professional email-ready HTML.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.2",
		"ernilambar/optiz": "^1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"ernilambar/coding-standard": "^2.0",
		"php-parallel-lint/php-parallel-lint": "dev-develop#f8cb90a",
		"phpcompatibility/php-compatibility": "^10.0",
		"phpunit/phpunit": "^9.6",
		"slevomat/coding-standard": "^8.22",
		"wp-cli/i18n-command": "^3.0",
		"wp-cli/wp-cli": "^3.0",
		"wp-coding-standards/wpcs": "^3.4",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/ernilambar/optiz"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Nilambar\\Notira\\": "app/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"php-http/discovery": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
		"lint": [
			"@lint-php",
			"@phpcs"
		],
		"lint-php": "@php ./vendor/bin/parallel-lint --colors --exclude .git --exclude vendor .",
		"mo": "./vendor/bin/wp i18n make-mo languages/",
		"phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary",
		"po": "./vendor/bin/wp i18n update-po languages/notira.pot languages/",
		"pot": "./vendor/bin/wp i18n make-pot . --exclude=build,deploy,node_modules,vendor --headers='{\"POT-Creation-Date\":\"\"}'",
		"test": "@php ./vendor/bin/phpunit"
	}
}
