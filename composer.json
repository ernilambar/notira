{
	"name": "ernilambar/notira",
	"description": "WordPress plugin to improve draft notes into professional email-ready HTML.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1",
		"ernilambar/coding-standard": "^1",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpcompatibility/php-compatibility": "^10",
		"slevomat/coding-standard": "^8",
		"wp-coding-standards/wpcs": "^3"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Nilambar\\Notira\\": "app/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"php-http/discovery": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
		"lint": [
			"@lint-php",
			"@phpcs"
		],
		"lint-php": "@php ./vendor/bin/parallel-lint -p php --colors --exclude .git --exclude vendor .",
		"phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary"
	}
}
