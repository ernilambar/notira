{
	"easyReplaceInFiles": [
		{
			"files": "readme.txt",
			"from": "Stable tag:\\s?(.+)",
			"type": "regex",
			"to": "Stable tag: $$package__version$$"
		},
		{
			"files": "$$package__main$$",
			"from": "\\* Version:\\s?(.+)",
			"type": "regex",
			"to": "* Version: $$package__version$$"
		},
		{
			"files": "$$package__main$$",
			"from": "define\\( 'NOTIRA_VERSION', '(.+)' \\);",
			"type": "regex",
			"to": "define( 'NOTIRA_VERSION', '$$package__version$$' );"
		}
	]
}
