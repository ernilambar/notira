#. Plugin Name of the plugin
#: notira.php:3
#: app/Core/Bootstrap.php:199
#: app/Core/Bootstrap.php:200
#: templates/admin-page.php:17
msgid "Notira"
msgstr "नोटिरा"

#. Plugin URI of the plugin
#: notira.php:4
msgid "https://github.com/ernilambar/notira"
msgstr "https://github.com/ernilambar/notira"

#. Description of the plugin
#: notira.php:5
msgid "Improve draft text into email-ready or proofread HTML using AI."
msgstr "AI प्रयोग गरेर ड्राफ्ट पाठलाई इमेल-तयार वा प्रुफरिड HTML मा रूपान्तरण गर्नुहोस्।"

#. Author of the plugin
#: notira.php:9
msgid "Nilambar Sharma"
msgstr "निलाम्बर शर्मा"

#. Author URI of the plugin
#: notira.php:10
msgid "https://nilambar.net/"
msgstr "https://nilambar.net/"

#. translators: %d: min character count
#: app/API/REST_API.php:128
#: app/API/REST_API.php:243
#, php-format
msgid "Input must be at least %d characters."
msgstr "इनपुट कम्तीमा %d अक्षरको हुनुपर्छ।"

#. translators: %d: max character count
#: app/API/REST_API.php:139
#: app/API/REST_API.php:254
#, php-format
msgid "Input must not exceed %d characters."
msgstr "इनपुट %d अक्षरभन्दा बढी हुनु हुँदैन।"

#. translators: 1: email mode slug, 2: proofread mode slug.
#: app/API/REST_API.php:163
#: app/API/REST_API.php:176
#: app/API/REST_API.php:229
#, php-format
msgid "A valid mode is required. Use %1$s or %2$s."
msgstr "एउटा मान्य मोड आवश्यक छ। %1$s वा %2$s प्रयोग गर्नुहोस्।"

#: app/API/REST_API.php:198
msgid "WordPress AI is not available or is disabled on this site."
msgstr "यस साइटमा WordPress AI उपलब्ध छैन वा अक्षम गरिएको छ।"

#: app/API/REST_API.php:206
msgid "API key is not set."
msgstr "API की सेट गरिएको छैन।"

#: app/API/REST_API.php:219
msgid "Please enter some text to improve."
msgstr "सुधार गर्न केही पाठ प्रविष्ट गर्नुहोस्।"

#: app/API/REST_API.php:351
msgid "Prompt templates are missing."
msgstr "प्रम्प्ट टेम्प्लेटहरू फेला परेनन्।"

#: app/API/REST_API.php:376
#: app/API/REST_API.php:389
msgid "No AI provider is configured."
msgstr "कुनै AI प्रदायक कन्फिगर गरिएको छैन।"

#: app/API/REST_API.php:394
msgid "Invalid API key."
msgstr "अमान्य API की।"

#: app/API/REST_API.php:397
msgid "API access denied. Check your API key and account."
msgstr "API पहुँच अस्वीकृत। आफ्नो API की र खाता जाँच गर्नुहोस्।"

#: app/API/REST_API.php:399
#: app/API/REST_API.php:405
#: app/API/REST_API.php:415
msgid "AI request failed."
msgstr "AI अनुरोध असफल भयो।"

#: app/Core/Bootstrap.php:96
msgid "Notira requires WordPress AI support (WordPress 7.0+). AI features are unavailable in this installation."
msgstr "नोटिराका लागि WordPress AI समर्थन आवश्यक छ (WordPress 7.0+)। यस इन्स्टलेसनमा AI सुविधाहरू उपलब्ध छैनन्।"

#: app/Core/Bootstrap.php:98
msgid "WordPress AI is disabled on this site (for example via the WP_AI_SUPPORT constant or a filter). Notira cannot generate text until AI support is enabled."
msgstr "यस साइटमा WordPress AI अक्षम गरिएको छ (उदाहरणका लागि WP_AI_SUPPORT स्थिरांक वा फिल्टरद्वारा)। AI समर्थन सक्षम नगरेसम्म नोटिराले पाठ उत्पन्न गर्न सक्दैन।"

#. translators: 1: opening link tag, 2: closing link tag
#: app/Core/Bootstrap.php:116
#, php-format
msgid "Please set your API key in %1$sConnectors%2$s to use this feature."
msgstr "यो सुविधा प्रयोग गर्न %1$sकनेक्टरहरू%2$s मा आफ्नो API की सेट गर्नुहोस्।"

#: app/Core/Bootstrap.php:262
#: app/Options/Options.php:60
msgid "Email"
msgstr "इमेल"

#: app/Core/Bootstrap.php:263
msgid "Polish your notes into a clear email body. Opening and closing lines from settings are added around the result."
msgstr "आफ्ना नोटहरूलाई स्पष्ट इमेल मुख्य भागमा परिमार्जन गर्नुहोस्। सेटिङबाट सुरुवाती र समापन लाइनहरू परिणामको वरिपरि थपिनेछन्।"

#: app/Core/Bootstrap.php:267
#: app/Options/Options.php:61
msgid "Proofread"
msgstr "प्रुफरिड"

#: app/Core/Bootstrap.php:268
msgid "Grammar, spelling, and punctuation corrections, with clarity improvements only where needed; preserves structure and meaning."
msgstr "व्याकरण, हिज्जे र विरामचिह्न सुधार, आवश्यक भएकोमा मात्र स्पष्टता सुधारसहित; संरचना र अर्थ सुरक्षित राख्छ।"

#: app/Core/Bootstrap.php:299
msgid "Enter draft notes or bullet points"
msgstr "ड्राफ्ट नोट वा बुलेट बुँदाहरू प्रविष्ट गर्नुहोस्"

