{
	"name": "notira",
	"version": "2.0.0",
	"description": "Improve draft text into email-ready or proofread HTML using AI.",
	"homepage": "https://github.com/ernilambar/notira#readme",
	"bugs": {
		"url": "https://github.com/ernilambar/notira/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ernilambar/notira.git"
	},
	"license": "GPL-2.0-or-later",
	"author": {
		"name": "Nilambar Sharma",
		"url": "https://nilambar.net/"
	},
	"type": "module",
	"main": "notira.php",
	"scripts": {
		"build": "vite build",
		"predeploy": "rimraf build deploy vendor && pnpm run build && pnpm run vendor",
		"deploy": "packtor",
		"format": "prettier . --write --log-level warn --plugin prettier-plugin-svelte",
		"vendor": "composer install --no-dev --no-scripts -o",
		"version": "easy-replace-in-files"
	},
	"prettier": "@wordpress/prettier-config",
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@wordpress/prettier-config": "^4.55.0",
		"easy-replace-in-files": "^2.0.0",
		"packtor": "^2.0.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rimraf": "^6.1.3",
		"svelte": "^5.57.0",
		"vite": "^8.3.0"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	}
}
